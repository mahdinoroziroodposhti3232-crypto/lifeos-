# === LifeOS Environment Variables ===

# Database (PostgreSQL) - Get free DB from https://neon.tech
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.vercel.app"

# Admin Panel Secret (choose a strong password)
ADMIN_SECRET="change-this-to-a-strong-secret"

# Optional: AI (leave empty for offline mode)
# OPENAI_API_KEY=""